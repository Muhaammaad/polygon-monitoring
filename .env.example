# DB (tests)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=data_hive

# Telegram (tests - mocked or dummy)
TELEGRAM_BOT_TOKEN=dummy
TELEGRAM_IT_CHANNEL_ID=

# Twilio (tests - mocked or dummy)
TWILIO_ACCOUNT_SID=dummy
TWILIO_AUTH_TOKEN=dummy
TWILIO_FROM_NUMBER=+41000000000     

# Notification behavior (global overrides)
ENABLE_SMS_FALLBACK=true
TELEGRAM_RETRY_COUNT=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Scheduler
SCHEDULER_INTERVAL=3

# Default time windows (fallback if not specified in city config)
DEFAULT_TIME_WINDOW_MINUTES=3

# Test mode
APP_ENV=test
